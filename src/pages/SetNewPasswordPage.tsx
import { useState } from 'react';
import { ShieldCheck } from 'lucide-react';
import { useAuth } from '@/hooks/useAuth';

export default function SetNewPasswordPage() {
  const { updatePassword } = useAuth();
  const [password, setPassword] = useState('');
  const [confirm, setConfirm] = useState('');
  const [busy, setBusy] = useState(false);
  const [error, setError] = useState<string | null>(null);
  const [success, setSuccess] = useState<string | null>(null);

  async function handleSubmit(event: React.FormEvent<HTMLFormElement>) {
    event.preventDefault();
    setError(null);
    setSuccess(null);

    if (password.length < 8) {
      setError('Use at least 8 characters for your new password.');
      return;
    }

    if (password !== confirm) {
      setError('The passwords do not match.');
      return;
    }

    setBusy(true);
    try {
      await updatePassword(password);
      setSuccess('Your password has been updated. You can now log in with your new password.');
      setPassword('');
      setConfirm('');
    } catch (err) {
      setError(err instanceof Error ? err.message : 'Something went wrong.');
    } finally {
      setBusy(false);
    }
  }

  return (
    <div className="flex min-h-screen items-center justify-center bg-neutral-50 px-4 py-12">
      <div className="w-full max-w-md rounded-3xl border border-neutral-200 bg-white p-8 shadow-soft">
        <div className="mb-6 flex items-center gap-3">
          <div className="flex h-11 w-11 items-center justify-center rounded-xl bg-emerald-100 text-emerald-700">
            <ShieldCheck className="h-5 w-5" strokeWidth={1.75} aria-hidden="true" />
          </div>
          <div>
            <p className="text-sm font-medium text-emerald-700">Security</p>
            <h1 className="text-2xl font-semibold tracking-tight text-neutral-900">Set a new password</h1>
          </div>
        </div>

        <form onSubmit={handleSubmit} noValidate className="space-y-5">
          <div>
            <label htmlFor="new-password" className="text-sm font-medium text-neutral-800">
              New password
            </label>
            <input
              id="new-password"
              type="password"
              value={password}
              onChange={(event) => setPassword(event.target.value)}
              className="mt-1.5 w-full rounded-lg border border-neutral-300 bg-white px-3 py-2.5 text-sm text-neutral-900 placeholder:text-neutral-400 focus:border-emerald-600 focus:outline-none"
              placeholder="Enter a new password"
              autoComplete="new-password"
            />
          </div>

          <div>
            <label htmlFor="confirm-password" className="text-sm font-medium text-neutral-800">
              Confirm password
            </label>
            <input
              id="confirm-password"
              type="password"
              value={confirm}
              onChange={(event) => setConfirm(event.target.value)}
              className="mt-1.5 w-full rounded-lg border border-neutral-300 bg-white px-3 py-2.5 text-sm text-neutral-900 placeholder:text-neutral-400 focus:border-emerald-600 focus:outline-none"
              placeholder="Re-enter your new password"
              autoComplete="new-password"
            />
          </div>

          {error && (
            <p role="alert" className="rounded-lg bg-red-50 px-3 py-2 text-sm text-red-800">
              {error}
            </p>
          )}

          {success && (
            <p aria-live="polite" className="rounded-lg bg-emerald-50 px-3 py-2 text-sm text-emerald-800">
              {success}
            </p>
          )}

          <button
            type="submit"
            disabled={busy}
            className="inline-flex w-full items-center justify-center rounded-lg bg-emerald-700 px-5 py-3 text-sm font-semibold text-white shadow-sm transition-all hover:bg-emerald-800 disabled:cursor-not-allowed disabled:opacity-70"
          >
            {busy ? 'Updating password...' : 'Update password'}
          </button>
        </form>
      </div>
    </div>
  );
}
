import { useEffect, useMemo, useState } from 'react';
import AccountManagementPage from '@/pages/AccountManagementPage';
import SetNewPasswordPage from '@/pages/SetNewPasswordPage';
import AppShell from '@/components/layout/AppShell';
import AccountingPage from '@/pages/AccountingPage';
import BookingsPage from '@/pages/BookingsPage';
import TripAssistantPage from '@/pages/TripAssistantPage';
import BillingPage from '@/pages/BillingPage';
import CalendarPage from '@/pages/CalendarPage';
import CalendarRulesPage from '@/pages/CalendarRulesPage';
import ContactsPage from '@/pages/ContactsPage';
import DashboardPage from '@/pages/DashboardPage';
import EmailAssistantPage from '@/pages/EmailAssistantPage';
import ExpensesPage from '@/pages/ExpensesPage';
import WelcomePage from '@/pages/WelcomePage';
import { useAuth } from '@/hooks/useAuth';
import { useHashRoute } from '@/hooks/useHashRoute';
import { useTheme } from '@/hooks/useTheme';

function hasRecoveryQuery() {
  const params = new URLSearchParams(window.location.search);
  return params.get('type') === 'recovery' || params.get('code') !== null;
}

function renderRoute(route: string) {
  switch (route) {
    case '/email':
      return <EmailAssistantPage />;
    case '/calendar-rules':
      return <CalendarRulesPage />;
    case '/billing':
      return <BillingPage />;
    case '/calendar':
      return <CalendarPage />;
    case '/expenses':
      return <ExpensesPage />;
    case '/contacts':
      return <ContactsPage />;
    case '/accounting':
      return <AccountingPage />;
    case '/bookings':
      return <BookingsPage />;
    case '/trip-assistant':
      return <TripAssistantPage />;
    case '/account-management':
      return <AccountManagementPage />;
    case '/set-new-password':
      return <SetNewPasswordPage />;
    default:
      return <DashboardPage />;
  }
}

function App() {
  const route = useHashRoute();
  const { user, loading } = useAuth();
  const { theme, toggleTheme } = useTheme();
  const [recoveryMode, setRecoveryMode] = useState(hasRecoveryQuery);

  useEffect(() => {
    const handleChange = () => setRecoveryMode(hasRecoveryQuery());
    window.addEventListener('hashchange', handleChange);
    window.addEventListener('popstate', handleChange);
    return () => {
      window.removeEventListener('hashchange', handleChange);
      window.removeEventListener('popstate', handleChange);
    };
  }, []);

  const needsPasswordResetPage = useMemo(() => recoveryMode || route === '/set-new-password', [recoveryMode, route]);

  if (loading) {
    return <div className="min-h-screen bg-white" aria-busy="true" />;
  }

  if (needsPasswordResetPage) {
    return <SetNewPasswordPage />;
  }

  if (!user) return <WelcomePage />;

  return (
    <AppShell theme={theme} onToggleTheme={toggleTheme}>
      {renderRoute(route)}
    </AppShell>
  );
}

export default App;
